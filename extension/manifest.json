{
  "manifest_version": 3,
  "name": "Kangae",
  "version": "0.0.2",
  "description": "AI があなたの Chrome の tab を、あなたの許した範囲で読み・操作できるようにする拡張（Kangae Bar と一緒に使います）。新しいタブでは、思った事を投げると返事と次の一手が返ります",
  "key": "",
  "permissions": ["nativeMessaging", "alarms", "tabs", "tabGroups", "sidePanel", "declarativeNetRequest", "scripting", "webNavigation", "offscreen", "cookies", "storage"],
  "action": { "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" } }, "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "sw.js", "type": "module" },
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "minimum_chrome_version": "121",
  "host_permissions": ["http://*/*", "https://*/*"],
  "optional_permissions": ["history"],
  "declarative_net_request": { "rule_resources": [{ "id": "embed", "enabled": true, "path": "embed-rules.json" }] }
}

