{
  "manifest_version": 3,
  "name": "expC",
  "version": "0.0.1",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "sw.js" },
  "content_scripts": [{ "matches": ["http://localhost:8765/*", "http://127.0.0.1:8765/*"], "js": ["content.js"], "run_at": "document_idle" }]
}
